:root {
    /* Cores Principais - Estética Industrial de Luxo */
    --primary: #f2f2f2;           /* Prata Nobre */
    --primary-light: #ffffff;     /* Brilho Máximo (Specular Highlight) */
    --bg-dark: #020202;           /* Preto Absoluto para contraste infinito */
    --card-bg: rgba(255, 255, 255, 0.015); /* Vidro ultra-translúcido */
    --text-main: #f5f5f7;         /* Branco Apple (suave) */
    --text-dim: #6e6e73;          /* Cinza Espacial fosco */
    
    /* Bordas e Divisores - O segredo do efeito espelhado */
    --glass-border: rgba(255, 255, 255, 0.18);
    --mirror-edge: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 50%, rgba(255,255,255,0.1) 100%);

    /* Acentos e Status */
    --accent-blue: #0071e3;       /* Royal Blue (estilo interface de precisão) */
    --success: #64ffda;           /* Turquesa Metálico */
    --danger: #ff2d55;            /* Crimson Red */
    
    /* Refatoração de profundidade */
    --bg-gradient-1: #1a1a1a;     /* Cinza Carbono */
    --bg-gradient-2: #000000;
    --input-bg: rgba(255, 255, 255, 0.03);
    --inner-circle-bg: #000000;
    --column-header-bg: rgba(10, 10, 10, 0.8);
    --todo-item-bg: rgba(255, 255, 255, 0.03);
    --todo-item-expanded: rgba(255, 255, 255, 0.07);
    --subtask-bg: rgba(255, 255, 255, 0.02);
    --subtask-hover: rgba(255, 255, 255, 0.08);
    
    /* Efeitos de Sombra de Alta Definição */
    --shadow-mirror: 0 8px 32px 0 rgba(0, 0, 0, 0.8), 
                     inset 0 0 0 1px rgba(255, 255, 255, 0.05);
}

:root {
    /* Cores Principais - Estética Midnight Emerald */
    --primary: #00ff85;           /* Verde Neon (Acento principal) */
    --primary-light: #ffffff;     /* Branco para brilhos extremos */
    --bg-dark: #050505;           /* Preto profundo (Fundo neutro) */
    --card-bg: rgba(18, 18, 18, 0.75); /* Vidro fumê quase preto */
    --text-main: #f0fdf4;         /* Off-white com um toque gélido */
    --text-dim: #52525b;          /* Cinza neutro para não poluir */
    
    /* Bordas e Detalhes - Onde o verde brilha */
    --glass-border: rgba(255, 255, 255, 0.08); /* Borda neutra */
    --accent-green-glow: rgba(0, 255, 133, 0.15); /* Apenas um halo sutil */

    /* Acentos e Status */
    --accent-blue: #0ea5e9;       
    --success: #00ff85;           
    --danger: #ef4444;            
    
    /* Refatoração de Backgrounds (Neutralizados) */
    --bg-gradient-1: #0c0c0c;     /* Cinza asfalto muito escuro */
    --bg-gradient-2: #050505;     /* Preto absoluto */
    --input-bg: rgba(255, 255, 255, 0.03); /* Input neutro */
    --inner-circle-bg: #0a0a0a;
    --column-header-bg: rgba(5, 5, 5, 0.95); /* Header quase opaco */
    
    /* Itens da Lista (Visual Minimalista) */
    --todo-item-bg: rgba(255, 255, 255, 0.02); /* Quase invisível */
    --todo-item-expanded: rgba(255, 255, 255, 0.05);
    --subtask-bg: rgba(0, 0, 0, 0.4);
    --subtask-hover: rgba(0, 255, 133, 0.08); /* Verde aparece apenas no hover */
    
    --shadow-dark: rgba(0, 0, 0, 0.9);
}

