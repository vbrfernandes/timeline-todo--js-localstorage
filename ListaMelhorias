:root {
    /* ===============================
       PALETA DA IMAGEM (TEMA ESCURO)
       =============================== */

    /* Cores Principais (Baseadas na Imagem) */
    --primary: #689689;             /* Cambridge Blue: Cor de destaque principal */
    --primary-light: #B2E6D4;       /* Tiffany Blue: Realces mais claros */
    --accent-aqua: #83E8BA;         /* Aquamarine: Acentos vibrantes */
    
    /* Cores de Fundo e Superfície (Baseadas no Taupe) */
    --bg-dark: #1a1614;             /* Taupe muito escuro para o fundo */
    --card-bg: rgba(80, 65, 54, 0.6); /* Taupe (#504136) com transparência */
    
    /* Cores de Texto (Baseadas no Khaki) */
    --text-main: #ffffff;           /* Branco para contraste máximo */
    --text-dim: #A49E8D;            /* Khaki para texto secundário */
    
    /* Cores de Borda e Vidro */
    --glass-border: rgba(164, 158, 141, 0.2); /* Khaki com transparência */
    
    /* Cores de Estado (Adicionadas para complementar) */
    --success: #83E8BA;             /* Aquamarine: Sucesso */
    --danger: #E68383;              /* Vermelho suave: Erro */
    --warning: #E6C783;             /* Dourado suave: Aviso */

    /* ===============================
       CORES REFATORADAS (COM A NOVA PALETA)
       =============================== */

    /* Gradientes de Fundo */
    --bg-gradient-1: #2a2624;       /* Taupe escuro */
    --bg-gradient-2: #1a1614;       /* Fundo principal */
    
    /* Elementos de UI */
    --input-bg: rgba(80, 65, 54, 0.3);
    --inner-circle-bg: #2a2624;
    --column-header-bg: rgba(80, 65, 54, 0.4);
    
    /* Itens e Listas */
    --todo-item-bg: rgba(164, 158, 141, 0.05);
    --todo-item-expanded: rgba(164, 158, 141, 0.1);
    --subtask-bg: rgba(80, 65, 54, 0.2);
    --subtask-hover: rgba(104, 150, 137, 0.1); /* Cambridge Blue suave */

    /* Sombras e Overlays */
    --modal-overlay: rgba(26, 22, 20, 0.8);
    --shadow-dark: rgba(0, 0, 0, 0.4);
    --danger-soft: rgba(230, 131, 131, 0.1);
    --danger-shadow: rgba(230, 131, 131, 0.3);
}


:root {
    /* ===============================
       PALETA "FLORESTA MINERAL" (Baseada na Imagem)
       =============================== */

    /* AS NOVAS PROTAGONISTAS (Verdes e Azuis) */
    --primary: #689689;             /* Cambridge Blue: O novo foco principal */
    --primary-light: #B2E6D4;       /* Tiffany Blue: Luz e interações */
    --accent-vibrant: #83E8BA;      /* Aquamarine: Destaques e Sucesso */

    /* AS CORES DE BASE (Marrom e Khaki rebaixados) */
    /* Misturamos o Taupe com preto para um fundo profundo, menos "marrom" */
    --bg-dark: #1e1b19;
    /* O Khaki é usado para suavizar o branco puro */
    --text-off-white: #f0f2ee;
    --text-dim: #A49E8D;            /* Khaki original para texto de apoio */

    /* ===============================
       SUPERFÍCIES E LUZ (Foco no Vidro Esverdeado)
       =============================== */

    /* Gradiente sutil que vai do Taupe profundo para um tom mais frio */
    --bg-gradient: linear-gradient(135deg, #241d1a 0%, #1a2422 100%);

    /* Cards agora são mais neutros, deixando a cor para o conteúdo */
    --card-bg: rgba(35, 30, 28, 0.8);
    
    /* Bordas usam o Tiffany Blue para dar um aspecto de "vidro mineral" */
    --glass-border: rgba(178, 230, 212, 0.15);
    --glass-border-bright: rgba(178, 230, 212, 0.4);

    /* ===============================
       ESTADOS E INTERAÇÕES
       =============================== */
    
    --success: #83E8BA;             /* Aquamarine */
    /* Uma cor de erro nova que complementa a paleta fria (um coral suave) */
    --danger: #E68383;

    /* Itens de lista agora têm um tom esverdeado sutil */
    --todo-item-bg: rgba(104, 150, 137, 0.08); /* Tintura de Cambridge Blue */
    --todo-item-hover: rgba(178, 230, 212, 0.12); /* Tintura de Tiffany Blue */

    /* Inputs e modais */
    --input-bg: rgba(0, 0, 0, 0.3);
    --modal-overlay: rgba(20, 26, 24, 0.85); /* Overlay com tom frio */
}

:root {
    /* ===============================
       PALETA "SOLAR INDUSTRIAL" (Protagonismo Amarelo/Laranja)
       =============================== */

    /* AS PROTAGONISTAS (Cores Quentes) */
    --primary: #FFAE42;             /* Yellow Orange: A cor principal de ação */
    --primary-dark: #C36721;        /* Ruddy Brown: Para textos em destaque e bordas fortes */
    --accent-sun: #F3D643;          /* Sandstorm: A cor de preenchimento dos itens */
    --highlight-glow: #FFCC33;      /* Sunglow: Para detalhes que precisam brilhar */

    /* O SUPORTE DE CONTRASTE (Azuis rebaixados para detalhes) */
    --accent-blue: #073376;         /* Catalina Blue: Usado apenas para o texto (máxima leitura) */
    --accent-teal: #29B2A0;         /* Light Sea Green: Apenas para "Sucesso/Check" */

    /* SUPERFÍCIES QUENTES */
    /* Fundo agora é um "Papel Amarelado" técnico */
    --bg-main: #FFFDF0;             
    --bg-gradient: linear-gradient(
        135deg, 
        #FFFDF0 0%, 
        #FDF5D7 100%
    );

    /* CARDS: Agora eles têm cor de verdade */
    --card-bg: #FFFFFF;             /* Branco puro para destacar do fundo creme */
    --todo-item-bg: #FDF5D7;        /* Fundo Sandstorm suave para as tarefas */
    --todo-item-hover: #F3D643;     /* Amarelo mais intenso no hover */

    /* TEXTO TÉCNICO */
    --text-main: #073376;           /* Catalina Blue para o texto (contrasta lindamente com amarelo) */
    --text-muted: #8E7B3E;          /* Um tom de ocre para textos secundários */

    /* BORDAS E ESTRUTURA RÍGIDA */
    --glass-border: #FFCC33;        /* Borda Sunglow (Amarela) */
    --glass-border-bright: #C36721; /* Borda Laranja para foco */

    /* FEEDBACK */
    --success: #29B2A0;
    --danger: #C36721;
    --danger-soft: rgba(195, 103, 33, 0.1);
}